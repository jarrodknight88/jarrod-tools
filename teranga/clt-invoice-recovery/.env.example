# Copy to .env and fill in. NEVER commit .env.

# --- Account gate (step 1) ---
# The Charlotte Gmail address. Every script verifies the authenticated
# mailbox against this and refuses to run on a mismatch (e.g. Brookhaven/ATL).
CLT_GMAIL_ADDRESS=

# Comma-separated names the CLT entity may appear as on a billed-to line.
# ATL lesson: invoices said "Clutch Restaurant" not "Teranga City".
# Add every legal/DBA name you confirm for Charlotte.
CLT_ENTITY_NAMES=Teranga CLT,Teranga Charlotte

# --- Sheets ---
CLT_RECON_SHEET_ID=
CLT_RECON_TAB=
# Optional numeric sheetId of the tab (from the sheet URL gid=...)
CLT_RECON_TAB_SHEETID=

# Optional intake tracker (leave blank if CLT doesn't use one)
CLT_PROCESSED_SHEET_ID=
CLT_PROCESSED_TAB=

# --- Drive ---
# CLT-specific archive folder for loaded invoice PDFs/images
DRIVE_ARCHIVE_FOLDER_ID=

# --- Outage window (CONFIRM exact dates before loading anything) ---
# Dashboard showed roughly mid-May to early July; these are placeholders.
OUTAGE_START=2026-05-15
OUTAGE_END=2026-07-05

# --- Vendors ---
# Priority vendors for the CLT recovery sweep (comma-separated)
PRIORITY_VENDORS=Cheney Brothers,Restaurant Depot,ABC Spirits,US Foods

# --- Recon column layout ---
# 1-based header row and the header names classify.py/load.py should use.
# Confirm these against the actual CLT expense-detail tab before running.
RECON_HEADER_ROW=1
RECON_COL_VENDOR=Vendor
RECON_COL_DATE=Date
RECON_COL_INVOICE=Invoice #
RECON_COL_AMOUNT=Amount
RECON_COL_DESC=Description

# --- Sanity thresholds ---
# Flag if amount is more than this multiple of the vendor's recon average
AMOUNT_HIGH_MULT=2.5
# ...or less than this fraction of it
AMOUNT_LOW_MULT=0.2
