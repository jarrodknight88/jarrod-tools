# Afro District (Atlanta) profile — copy to .env in a SEPARATE checkout or
# swap in place of the CLT .env before running. NEVER commit a filled .env.
#
# Phase 1 (bulk download + manifest):
#   1. Put the OAuth Desktop-app credentials.json next to these scripts
#      (repo root copies work too — pass the path or copy it here).
#   2. python3 clt_auth.py         <- browser consent AS afrodistrictatl@gmail.com
#   3. python3 fetch_invoices.py   <- downloads every PDF/image attachment
#      matching the query into ./clt_invoices/ and writes manifest.csv
#
# The mailbox gate verifies the token against CLT_GMAIL_ADDRESS below on
# every run (the variable name is historical — it means "this profile's
# mailbox").

CLT_GMAIL_ADDRESS=afrodistrictatl@gmail.com

# Names the Afro District entity may appear as on billed-to lines.
# CONFIRM against real invoices — the ATL run taught us billed-to names
# rarely match the trade name (e.g. "Clutch Restaurant" for Teranga City).
CLT_ENTITY_NAMES=Afro District,Teranga Afro,Afro District Bar and Restaurant,Teranga Group

# Do NOT include 'atl' here — this profile's own mailbox contains it.
WRONG_MAILBOX_HINTS=brookhaven,teranga clt,terangaclt

# --- Sheets ---
# "Afro District Yearly Performance 2026" (Expense Detail tab columns:
# Date, Vendor, Category, Amount, Notes, Original Vendor)
CLT_RECON_SHEET_ID=1Jo4gMHhmGRVvmHKbCFuFzuBXkfjlmdMK-Yg_S86jAEY
CLT_RECON_TAB=Expense Detail
CLT_PROCESSED_SHEET_ID=
CLT_PROCESSED_TAB=

# --- Drive ---
# Create an "Afro District Invoice Recovery" folder and put its ID here.
DRIVE_ARCHIVE_FOLDER_ID=

# --- Sweep window (full year 2026; fetch pads this automatically) ---
OUTAGE_START=2026-01-01
OUTAGE_END=2026-07-11

# --- Vendors (CONFIRM; drawn from the Afro District expense detail) ---
PRIORITY_VENDORS=US Foods,Restaurant Depot,King Ola Distributions,Georgia Crown,Empire Distributors

# --- Recon column layout ---
RECON_HEADER_ROW=1
RECON_COL_VENDOR=Vendor
RECON_COL_DATE=Date
RECON_COL_INVOICE=
RECON_COL_AMOUNT=Amount
RECON_COL_DESC=Notes

# --- Sanity thresholds ---
AMOUNT_HIGH_MULT=2.5
AMOUNT_LOW_MULT=0.2
